{
  "manifest_version": 3,
  "name": "Radiant Wallet",
  "version": "1.0.0",
  "description": "Radix DLT Web Wallet Chrome Extension",
  "action": {
    "default_popup": "dist/src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
